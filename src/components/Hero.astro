---
import Picture from './Picture.astro';
import type { Locale } from '../config/site';
import { getCopy } from '../i18n';

interface Props {
  locale: Locale;
}

const t = getCopy(Astro.props.locale);
---

<section class="hero" data-nav="ink" data-hero aria-labelledby="hero-title">
  <div class="hero__media">
    <Picture
      desktop="haus-am-hang-wide"
      mobile="haus-am-hang-portrait"
      alt={t.projects.hausAmHang.alt}
      sizes="100vw"
      eager
    />
  </div>

  <h1 class="hero__title display" id="hero-title">
    {
      t.hero.title.map((line, i) => (
        <span class="mask" style={`--i:${i}`}>
          <span class="mask__in">{line}</span>{' '}
        </span>
      ))
    }
  </h1>

  <div class="hero__foot label">
    <p class="hero__meta">
      {t.hero.meta.map((line) => <span class="ln">{line}</span>)}
    </p>
    <p class="hero__scroll" aria-hidden="true">{t.hero.scroll}</p>
    <p class="hero__index">01 / 03</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 480px;
    overflow: hidden;
    overflow: clip;
    background: #e7ecf1;
    --p: 0;
  }

  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__media :global(picture),
  .hero__media :global(img) {
    width: 100%;
    height: 100%;
  }

  .hero__media :global(img) {
    object-fit: cover;
    object-position: 72% 50%;
    transform: scale(calc(1 + var(--p) * 0.03));
    transform-origin: 60% 60%;
    will-change: transform;
  }

  /* Headline sits in the open sky, upper left */
  .hero__title {
    position: absolute;
    top: clamp(96px, 15vh, 170px);
    left: var(--m);
    font-size: min(7vw, 12.5vh);
    color: var(--charcoal);
    transform: translate3d(0, calc(var(--p) * -56px), 0);
    will-change: transform;
  }

  /* Straight clipping mask. Top padding keeps Ä/Ü dots inside the mask. */
  .mask {
    display: block;
    overflow: hidden;
    white-space: nowrap;
    padding-top: 0.2em;
    margin-top: -0.2em;
    padding-bottom: 0.06em;
    margin-bottom: -0.06em;
  }

  .mask__in {
    display: inline-block;
    animation: rise 1000ms var(--ease) both;
    animation-delay: calc(350ms + var(--i) * 90ms);
  }

  @keyframes rise {
    from {
      transform: translateY(125%);
    }
    to {
      transform: none;
    }
  }

  /* Bottom labels sit on the dark lawn, so they are ivory */
  .hero__foot {
    position: absolute;
    left: var(--m);
    right: var(--m);
    bottom: clamp(18px, 3.4vh, 36px);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: end;
    color: var(--ivory);
  }

  .hero__index {
    justify-self: end;
  }

  .hero__scroll {
    position: relative;
    padding-bottom: 22px;
  }

  .hero__scroll::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 1px;
    height: 16px;
    background: currentColor;
  }

  @media (max-width: 899px) {
    .hero__media :global(img) {
      object-position: 50% 50%;
      transform-origin: 50% 70%;
    }

    .hero__title {
      top: calc(var(--nav-h) + 1.6svh);
      font-size: min(15vw, 7.4svh);
    }

    .hero__foot {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'meta scroll'
        'meta index';
    }

    .hero__meta {
      grid-area: meta;
    }

    .hero__scroll {
      grid-area: scroll;
      justify-self: end;
      padding-bottom: 0;
    }

    .hero__scroll::after {
      display: none;
    }

    .hero__index {
      grid-area: index;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__media :global(img),
    .hero__title {
      transform: none;
    }
  }
</style>
