---
// Renders a real link only once FORMA_STUDIO_URL is set.
// Until then the text stays visible but is not a link and has no href.
import { FORMA_STUDIO_URL } from '../config/site';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

{
  FORMA_STUDIO_URL ? (
    <a class={className} href={FORMA_STUDIO_URL} target="_blank" rel="noopener">
      <slot />
      <svg class="arrow" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
        <path d="M2 10 10 2M3.5 2H10v6.5" fill="none" stroke="currentColor" stroke-width="1.4" />
      </svg>
    </a>
  ) : (
    <span class={className}>
      <slot />
      <svg class="arrow" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
        <path d="M2 10 10 2M3.5 2H10v6.5" fill="none" stroke="currentColor" stroke-width="1.4" />
      </svg>
    </span>
  )
}

<style>
  .arrow {
    display: inline-block;
    width: 0.72em;
    height: 0.72em;
    margin-left: 0.3em;
    vertical-align: baseline;
  }
</style>
